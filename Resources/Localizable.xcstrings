    "snapshotTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Container as Image…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将容器保存为映像…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將容器儲存為映像檔…"
          }
        }
      }
    },
    "snapshotScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the current root filesystem and startup command as a new image. Mounted folders and volumes, memory, network/port settings, restart policies and extra runtime privileges are not included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将当前根文件系统和启动命令保存为新映像。不包含挂载目录与卷、内存状态、网络与端口设置、重启策略或额外运行权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將目前根檔案系統和啟動指令儲存為新映像檔。不包含掛載資料夾與儲存卷、記憶體狀態、網路與連接埠設定、重啟策略或額外執行權限。"
          }
        }
      }
    },
    "snapshotImageName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New local image name:tag"
          }
        },
        "zh-Hans": {
