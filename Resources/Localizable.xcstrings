    "deployRosettaNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AMD64 runs through Rosetta on an ARM64 Linux VM. Compatibility and speed vary; this is not native ARM64 conversion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AMD64 通过 ARM64 Linux 虚拟机中的 Rosetta 运行。兼容性与速度因项目而异，不等同于转换为原生 ARM64。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
