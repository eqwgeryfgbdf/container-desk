    "migrationPolicy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the recognized per-user Apple Container layout can migrate to the same tested version. /usr/local must be unused and containers stopped. Original files and data are retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持已识别的个人用户 Apple Container 安装迁移到相同已验证版本。/usr/local 必须尚未安装且容器已停止。保留原文件与数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅支援已識別的個人使用者 Apple Container 安裝遷移至相同已驗證版本。/usr/local 必須尚未安裝且容器已停止。保留原檔案與資料。"
          }
        }
      }
    },
    "migrationImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the same official release under /usr/local and use it in this app. The idle engine will briefly stop. Existing container data and the original installation remain. macOS will request administrator authorization. Shell commands may still use your original PATH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将相同官方版本安装到 /usr/local 并在本应用使用。空闲引擎会短暂停止。保留现有容器数据与原安装。macOS 将请求管理员授权；终端仍可能使用原 PATH。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將相同官方版本安裝到 /usr/local 並在本應用程式使用。閒置引擎會短暫停止。保留既有容器資料與原安裝。macOS 將要求管理員授權；終端機仍可能使用原 PATH。"
          }
        }
      }
    },
