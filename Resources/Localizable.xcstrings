    "deployArchitectureNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ARM64 is preferred. Selecting another architecture downloads its published variant; it does not convert binaries. For a native ARM64 rebuild, use Build Image with the source project and Dockerfile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先使用 ARM64。切换架构会下载发布者提供的对应版本，不会转换二进制程序。需要原生 ARM64 时，请通过“构建映像”选择源项目和 Dockerfile 重新构建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "優先使用 ARM64。切換架構會下載發布者提供的對應版本，不會轉換二進位程式。需要原生 ARM64 時，請透過「建置映像檔」選擇原始專案和 Dockerfile 重新建置。"
          }
        }
      }
    },
