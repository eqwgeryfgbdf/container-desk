    "automaticPolicy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks once a day while the app is open. Automatic installs require a tested release, an idle engine, and macOS authorization. Untested releases are deferred."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用打开时每天检查一次。自动安装需要已验证的版本、空闲引擎及 macOS 授权。未经验证的版本会延后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式開啟時每天檢查一次。自動安裝需要已驗證的版本、閒置引擎及 macOS 授權。未經驗證的版本會延後。"
          }
        }
      }
    },
