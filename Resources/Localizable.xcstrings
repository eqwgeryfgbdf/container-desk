        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个原样参数，保留空格，不进行 Shell 展开。留空使用镜像默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一個原樣參數，保留空白，不進行 Shell 展開。留空使用映像檔預設值。"
          }
        }
      }
    },
