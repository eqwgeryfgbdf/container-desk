        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存取權杖或密碼"
          }
        }
      }
    },
    "registryLocalHTTP": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP for a local loopback registry only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对本机回环仓库使用 HTTP"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅對本機迴路倉庫使用 HTTP"
          }
        }
      }
    },
    "registryCredentialNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credentials are sent through stdin to Apple Container, which stores them in macOS Keychain. Container Desk does not save passwords."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭证通过标准输入传给 Apple Container，由其存入 macOS 钥匙串。Container Desk 不保存密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證透過標準輸入傳給 Apple Container，由其存入 macOS 鑰匙圈。Container Desk 不儲存密碼。"
          }
        }
      }
    },
    "registryLogoutNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the saved login used by Apple Container. Running containers and local images are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Apple Container 使用的已保存登录，保留运行中的容器和本地镜像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Apple Container 使用的已儲存登入，保留運行中的容器與本機映像檔。"
          }
        }
      }
    },
    "noRegistries": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved registry logins"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已保存的仓库登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已儲存的倉庫登入"
          }
        }
      }
    },
    "registryUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registry logins could not be read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取仓库登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取倉庫登入。"
          }
        }
      }
    },
    "invalidRegistry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a hostname with an optional port; omit the scheme and path."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入主机名和可选端口，不含协议或路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入主機名稱與選填連接埠，不含協定或路徑。"
          }
        }
      }
    },
    "registryHTTPSRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote registries require HTTPS. HTTP is limited to loopback addresses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远端仓库必须使用 HTTPS，HTTP 仅限本机回环地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端倉庫必須使用 HTTPS，HTTP 僅限本機迴路位址。"
          }
        }
      }
    },
    "registryCredentialsRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a username and a non-empty token or password (maximum 4 KiB)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入用户名及非空令牌或密码（最多 4 KiB）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入使用者名稱及非空權杖或密碼（最多 4 KiB）。"
          }
        }
      }
    },
    "registryLoginFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in failed or timed out. Check the address, credentials, connection and Keychain access. Authentication output is hidden to protect credentials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录失败或超时，请检查地址、凭证、连接和钥匙串权限。认证输出已隐藏以保护凭证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入失敗或逾時，請檢查位址、憑證、連線與鑰匙圈權限。認證輸出已隱藏以保護憑證。"
          }
        }
      }
    },
    "pushImage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push Image…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送镜像…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推送映像檔…"
          }
        }
      }
    },
    "pushDestination": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destination image reference"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标镜像名称"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標映像檔名稱"
          }
        }
      }
    },
    "pushImageNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push publishes this image to the specified registry and may replace that remote tag. A new local tag is retained even if pushing fails. Sign in from Registries first when required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送会将镜像发布至指定仓库，可能替换远端标签。即使失败，新增的本地标签仍会保留；如需认证，请先在镜像仓库页登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推送會將映像檔發佈至指定倉庫，可能取代遠端標籤。即使失敗，新增的本機標籤仍會保留；如需認證，請先在倉庫頁登入。"
          }
        }
      }
    },
    "registryQualifiedImage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a complete registry/namespace/image:tag destination."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用完整的 仓库/命名空间/镜像:标签 目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用完整的 倉庫/命名空間/映像檔:標籤 目標。"
          }
        }
      }
    },
    "imageTagExists": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That local target tag already exists. Choose a new tag or push that image directly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地目标标签已存在，请使用新标签或直接推送该镜像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機目標標籤已存在，請使用新標籤或直接推送該映像檔。"
          }
        }
      }
    },
    "composeProjects": {
