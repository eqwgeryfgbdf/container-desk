    },
    "snapshotIncludeEnvironment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include environment variables"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含环境变量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含環境變數"
          }
        }
      }
    },
    "snapshotEnvironmentNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environment values may contain credentials. They are omitted by default; restore required variables when deploying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境变量可能包含凭据，默认不保存；部署时请补回必需的变量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境變數可能包含憑證，預設不儲存；部署時請補回必要的變數。"
          }
        }
      }
    },
    "snapshotFilesAcknowledgement": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand container files may contain private data or credentials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解容器文件可能包含私人数据或凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解容器檔案可能包含私人資料或憑證。"
          }
        }
      }
    },
    "snapshotRunningAcknowledgement": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture the running filesystem; application/database consistency is not guaranteed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对运行中的文件系统制作快照，不保证应用或数据库一致性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對執行中的檔案系統製作快照，不保證應用程式或資料庫一致性。"
          }
        }
      }
    },
    "snapshotWorking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
