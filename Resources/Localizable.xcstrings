    "snapshotReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshot image saved locally."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快照映像已保存到本地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快照映像檔已儲存到本機。"
          }
        }
      }
    },
    "snapshotPushNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push sends all saved filesystem contents to the destination registry using saved CLI credentials. Review the image first. Repository visibility and permissions are managed by the registry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送会使用已保存的 CLI 凭据，将快照文件系统发送到目标仓库。请先检查映像；仓库可见性及权限由 Registry 管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推送會使用已儲存的 CLI 憑證，將快照檔案系統傳送到目標倉庫。請先檢查映像檔；倉庫可見性及權限由 Registry 管理。"
          }
        }
      }
    },
    "snapshotUnsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This container state or startup configuration cannot be preserved safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保留此容器状态或启动配置。"
          }
        },
