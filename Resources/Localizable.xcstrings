    "restartImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service will stop and start again. If starting fails, the container remains stopped; inspect its logs before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务将停止后重新启动。如果启动失败，容器将保持停止状态；请先查看日志再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務將停止後重新啟動。如果啟動失敗，容器將保持停止狀態；請先查看日誌再重試。"
          }
        }
      }
    },
    "deleteResourceConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this resource?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此资源？"
          }
