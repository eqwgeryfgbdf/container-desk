    "stopImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service will be interrupted. Its data is not deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务将中断，不会删除数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務將中斷，不會刪除資料。"
          }
        }
      }
    },
    "deleteImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The container and its writable layer will be deleted. Referenced named volumes are not removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器及其可写层将被删除。引用的命名卷不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "容器及其可寫層將被刪除。引用的具名儲存卷不會被刪除。"
          }
        }
      }
    },
