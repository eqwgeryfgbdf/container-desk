    "deleteFileNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion is permanent. Only files, symlinks and empty folders can be removed; mounted data may be affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除不可撤销。仅可移除文件、符号链接及空文件夹；可能影响挂载的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除無法復原。僅可移除檔案、符號連結及空資料夾；可能影響掛載的資料。"
          }
        }
      }
    },
    "fileNoOverwrite": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a new name. Existing items will not be overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用新名称，不会覆盖现有项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用新名稱，不會覆寫現有項目。"
          }
        }
      }
    },
    "invalidFilePath": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an absolute path without a colon, NUL or parent traversal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用不含冒号、NUL 或上级跳转的绝对路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用不含冒號、NUL 或上層跳轉的絕對路徑。"
          }
        }
      }
    },
    "fileEncodingUnsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder contains names that are not UTF-8. Use the terminal to manage them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹含非 UTF-8 名称，请使用终端管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料夾含非 UTF-8 名稱，請使用終端機管理。"
          }
        }
      }
    },
    "invalidFileListing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read this directory safely. Check shell availability and permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全读取目录，请检查 shell 和权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全讀取目錄，請檢查 shell 與權限。"
          }
        }
      }
    },
    "fileDestinationExists": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destination already exists. Choose another folder or rename the item first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标已存在，请选择其他文件夹或先重命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標已存在，請選擇其他資料夾或先重新命名。"
          }
        }
      }
    },
    "fileSymlinkUpload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the actual file or folder instead of a symbolic link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择实际文件或文件夹，而非符号链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇實際檔案或資料夾，而非符號連結。"
          }
        }
      }
    },
    "transferStagingNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary upload path (a failed or cancelled transfer may leave it for inspection):"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时上传路径（失败或取消后可能保留，供检查）："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫存上傳路徑（失敗或取消後可能保留，供檢查）："
          }
        }
      }
