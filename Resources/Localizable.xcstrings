    "duplicatePort": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each host port and protocol pair must be unique."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机端口与协议的组合不可重复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主機連接埠與通訊協定的組合不可重複。"
          }
        }
      }
    },
    "duplicateMount": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount destinations must be unique."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挂载目的地不可重复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掛載目的地不可重複。"
          }
        }
      }
    },
