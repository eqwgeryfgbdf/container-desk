      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filesystem export failed. Apple Container 1.5 or later is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件系统导出失败，需要 Apple Container 1.5 或更新版本。"
          }
