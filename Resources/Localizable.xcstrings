    "batchStateChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State changed since confirmation. Review this container again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态已在确认后发生变化，请重新检查此容器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態已在確認後改變，請重新檢查此容器。"
          }
        }
      }
    },
    "batchIneligible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped: start/delete requires stopped; stop/restart requires running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过：启动/删除需要已停止；停止/重启需要运行中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳過：啟動／刪除需已停止；停止／重新啟動需運行中。"
          }
        }
      }
    },
    "batchSkipped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will be skipped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将跳过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將跳過"
          }
        }
      }
    },
    "batchUnconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine did not confirm the expected state. Refresh before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎未确认预期状态，请刷新后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎未確認預期狀態，請重新整理後再試。"
          }
        }
      }
    },
    "batchCancelledNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled. The current command may already have taken effect. Refresh these remaining targets before retrying:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消。目前的命令可能已生效，重试前请刷新以下剩余目标："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消。目前的指令可能已生效，重試前請重新整理以下剩餘目標："
          }
        }
      }
    },
    "batchSummary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        }
      }
    },
    "batchReviewNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the listed containers will be processed, one at a time. Ineligible or changed states are skipped. Failures do not stop the remaining items. Cancellation does not undo completed work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅逐一处理下列容器。状态不适用或已改变时跳过；单项失败后继续处理其余项目。取消不会撤销已完成的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅逐一處理下列容器。狀態不適用或已改變時跳過；單項失敗後繼續處理其餘項目。取消不會復原已完成的操作。"
          }
        }
      }
    },
