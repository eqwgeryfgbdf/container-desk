    "releaseNotes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release notes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新说明"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新說明"
          }
        }
      }
    },
    "kernelNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On first installation, Apple Container also downloads its recommended Linux guest kernel from the Kata Containers project on GitHub and verifies the configured digest. Updates preserve an existing kernel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次安装时，Apple Container 还会从 GitHub 上的 Kata Containers 项目下载推荐的 Linux 客体内核，并验证配置的摘要。更新保留现有内核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次安裝時，Apple Container 也會從 GitHub 上的 Kata Containers 專案下載建議的 Linux 客體核心，並驗證設定的摘要。更新會保留現有核心。"
          }
        }
      }
    },
    "installConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the official Container package?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装官方 Container 安装包？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝官方 Container 套件？"
          }
        }
      }
    },
    "installImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads and verifies the signed package from apple/container. First installation also downloads the recommended Linux guest kernel from kata-containers/kata-containers. macOS may request administrator authorization. Stop running containers before updating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并验证 apple/container 的签名安装包。首次安装还会从 kata-containers/kata-containers 下载推荐的 Linux 客体内核。macOS 可能要求管理员授权。更新前请停止运行中的容器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載並驗證 apple/container 的簽署套件。首次安裝也會從 kata-containers/kata-containers 下載建議的 Linux 客體核心。macOS 可能要求管理員授權。更新前請停止運行中的容器。"
          }
        }
      }
    },
    "externalInstall": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A custom installation was detected. Automatic replacement is disabled to preserve your existing setup. Use its original installer to update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到自定义安装。为保留现有环境，已禁用自动替换。请使用原安装工具更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到自訂安裝。為保留既有環境，已停用自動替換。請使用原安裝工具更新。"
          }
        }
      }
    },
    "compatibilityPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This release has not been verified with this app. Installation is deferred; see the official release notes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本尚未通过本应用验证，已延后安装；请查看官方更新说明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
