    "duplicatePort": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each host port and protocol pair must be unique."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机端口与协议的组合不可重复。"
          }
        },
