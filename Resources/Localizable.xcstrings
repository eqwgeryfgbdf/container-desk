        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The snapshot could not be imported. Check the local image list before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快照导入失败，请在重试前检查本地映像列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
