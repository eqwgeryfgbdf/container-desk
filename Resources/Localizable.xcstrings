    "composeScopeNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imports a supported Compose subset into Apple Container. Unsupported properties block import with a field path. Compose files are never executed during import."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将支持的 Compose 配置导入 Apple Container。不支持的属性会阻止导入并指出字段；导入时不会执行 Compose 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將支援的 Compose 設定匯入 Apple Container。不支援的屬性會阻止匯入並指出欄位；匯入時不會執行 Compose 檔案。"
          }
        }
      }
    },
    "composePreviewNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ports use loopback only. Managed volumes default to 8 GiB. Local images are reused; missing images are built or pulled. Health checks gate startup only while this operation is running; there is no continuous health or restart controller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口仅使用本机回环地址。托管卷默认为 8 GiB。复用本地镜像，仅构建或下载缺少的镜像。健康检查仅在此次启动期间生效，没有持续监控或自动重启控制器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接埠僅使用本機迴路位址。受管理儲存卷預設為 8 GiB。沿用本機映像檔，僅建置或下載缺少的映像檔。健康檢查僅在此次啟動期間生效，沒有持續監控或自動重啟控制器。"
          }
        }
      }
    },
    "composeStartNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the listed services and mounts. This starts their configured commands and may download images or build local Dockerfiles. Failure or cancellation leaves completed resources available for inspection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查列出的服务及挂载。此操作会启动配置中的命令，并可能下载镜像或构建本地 Dockerfile。失败或取消后会保留已完成的资源，供检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查列出的服務及掛載。此操作會啟動設定中的指令，並可能下載映像檔或建置本機 Dockerfile。失敗或取消後會保留已完成的資源，供檢查。"
          }
        }
      }
    },
    "composeRetainData": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the listed owned containers are affected. Images, networks and named volumes are retained. Removing containers deletes their writable layers; mounted volume data is retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅影响列出的本项目容器。保留镜像、网络和命名卷；移除容器会删除其可写层，挂载卷数据会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅影響列出的本專案容器。保留映像檔、網路與命名儲存卷；移除容器會刪除其可寫層，掛載卷資料會保留。"
          }
        }
      }
    },
    "composeLibraryFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the saved project list. Do not overwrite it; check the Application Support folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已保存的项目列表，请检查应用支持目录，勿覆盖原文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取已儲存的專案清單，請檢查應用程式支援目錄，勿覆寫原檔。"
          }
        }
      }
    },
    "composeNameConflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A resource is missing or belongs to another project. No ownership is assumed from its name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资源不存在或属于其他项目，不会仅凭名称认定所有权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資源不存在或屬於其他專案，不會僅憑名稱認定所有權。"
          }
        }
      }
    },
    "composeConfigurationChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration changed. Stop and remove the existing project containers before recreating them; named volumes are retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置已改变。请停止并移除现有项目容器后重新创建，命名卷会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定已改變。請停止並移除現有專案容器後重新建立，命名儲存卷會保留。"
          }
        }
      }
    },
    "composeExternalMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A declared external network or volume is missing. Create it first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
