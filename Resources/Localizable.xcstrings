    "restartImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service will stop and start again. If starting fails, the container remains stopped; inspect its logs before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务将停止后重新启动。如果启动失败，容器将保持停止状态；请先查看日志再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務將停止後重新啟動。如果啟動失敗，容器將保持停止狀態；請先查看日誌再重試。"
          }
        }
      }
    },
    "deleteResourceConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this resource?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此资源？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除此資源？"
          }
        }
      }
    },
    "deleteResourceImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this resource is deleted. Resources referenced by containers and built-in networks are protected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅删除此资源。容器引用的资源和内置网络受到保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅刪除此資源。容器引用的資源和內建網路受到保護。"
          }
        }
      }
    },
    "deleteVolumeImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data in this volume will be permanently deleted. Volumes referenced by containers are protected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此存储卷内的所有数据将永久删除。容器引用的卷受到保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此儲存卷內的所有資料將永久刪除。容器引用的儲存卷受到保護。"
          }
        }
      }
    },
    "protectedResource": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This built-in resource cannot be deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能删除此内置资源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不能刪除此內建資源。"
          }
        }
      }
    },
    "resourceInUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A container still references this resource. Remove its reference before deleting the resource."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有容器引用此资源。请先移除引用，再删除资源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有容器引用此資源。請先移除參照，再刪除資源。"
          }
        }
      }
    },
    "resourceDisappeared": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This resource no longer exists. Refresh the list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此资源已不存在，请刷新列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資源已不存在，請重新整理清單。"
          }
        }
      }
    },
    "operationOutputLimit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output exceeded the task limit. The CLI client was stopped; refresh to check engine state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输出超过任务限制。CLI 客户端已停止；请刷新确认引擎状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸出超過工作限制。CLI 用戶端已停止；請重新整理確認引擎狀態。"
          }
        }
      }
    },
    "operationFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operation failed. Review the output below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作失败，请查看以下输出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作失敗，請查看以下輸出。"
          }
        }
      }
    },
    "operationCancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled. Refresh to check whether the engine completed any work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消。请刷新确认引擎是否已完成部分工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消。請重新整理確認引擎是否已完成部分工作。"
          }
        }
