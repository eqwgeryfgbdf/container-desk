    "hubConfigurationNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An image is not a complete deployment recipe. Review its documentation, ports, required environment variables and persistent volumes in the next step. Nothing starts automatically. Private registries use saved CLI credentials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜像不是完整部署方案。请根据其文档，在下一步检查端口、必需的环境变量及持久化卷。不会自动启动；私有仓库使用已保存的 CLI 凭证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
