    "deleteResourceImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this resource is deleted. Resources referenced by containers and built-in networks are protected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅删除此资源。容器引用的资源和内置网络受到保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅刪除此資源。容器引用的資源和內建網路受到保護。"
          }
        }
      }
    },
    "deleteVolumeImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data in this volume will be permanently deleted. Volumes referenced by containers are protected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此存储卷内的所有数据将永久删除。容器引用的卷受到保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此儲存卷內的所有資料將永久刪除。容器引用的儲存卷受到保護。"
          }
        }
      }
    },
